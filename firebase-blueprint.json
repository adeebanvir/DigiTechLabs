{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Public and private user demographic and role information.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "admin", "support"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "Electronic gadget or accessory details.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "image": { "type": "string" },
        "rating": { "type": "number" },
        "reviews": { "type": "number" },
        "features": { "type": "array" },
        "specs": { "type": "object" },
        "stock": { "type": "number" },
        "isNew": { "type": "boolean" },
        "isBestSeller": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "category", "stock"]
    },
    "Category": {
      "title": "Category",
      "description": "Product categorization.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "image": { "type": "string" }
      },
      "required": ["name", "slug"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase transaction record.",
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "userId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "paid", "processing", "shipped", "delivered", "cancelled"] },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "shippingAddress": { "type": "object" },
        "paymentId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "status", "items", "total"]
    },
    "Review": {
      "title": "Product Review",
      "description": "Customer feedback on a product.",
      "type": "object",
      "properties": {
        "reviewId": { "type": "string" },
        "productId": { "type": "string" },
        "userId": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "userName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "userId", "rating"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles and role assignments."
    },
    "products/{productId}": {
      "schema": "Product",
      "description": "Store inventory of gadgets."
    },
    "categories/{categoryId}": {
      "schema": "Category",
      "description": "Product hierarchy."
    },
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders and payment statuses."
    },
    "products/{productId}/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Individual product reviews."
    }
  }
}
