{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Public and private user demographic and role information.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "admin", "support", "super-admin"] },
        "status": { "type": "string", "enum": ["active", "suspended", "banned"] },
        "provider": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastLogin": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "role", "status", "provider"]
    },
    "Product": {
      "title": "Product",
      "description": "Electronic gadget or accessory details.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "discount": { "type": "number" },
        "category": { "type": "string" },
        "image": { "type": "string" },
        "rating": { "type": "number" },
        "reviews": { "type": "number" },
        "isReviewsEnabled": { "type": "boolean" },
        "features": { "type": "array" },
        "specs": { "type": "object" },
        "stock": { "type": "number" },
        "isNew": { "type": "boolean" },
        "isBestSeller": { "type": "boolean" },
        "status": { "type": "string", "enum": ["published", "draft", "archived"] },
        "sku": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "category", "stock", "productId"]
    },
    "Category": {
      "title": "Category",
      "description": "Product categorization.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "image": { "type": "string" }
      },
      "required": ["name", "slug"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase transaction record with full tracking.",
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "paid", "processing", "shipped", "delivered", "cancelled", "refunded"] },
        "paymentStatus": { "type": "string", "enum": ["pending", "completed", "failed", "refunded"] },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "shippingAddress": { "type": "string" },
        "trackingCode": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "status", "items", "total"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Promotional discounts.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "discountType": { "type": "string", "enum": ["percentage", "fixed"] },
        "value": { "type": "number" },
        "expiryDate": { "type": "string", "format": "date-time" },
        "usageCount": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["code", "discountType", "value"]
    },
    "Ticket": {
      "title": "Support Ticket",
      "description": "Customer support inquiries.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "in-progress", "resolved", "closed"] },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "urgent"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Address": {
      "title": "User Address",
      "description": "Shipping or billing address details.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "street": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "postalCode": { "type": "string" },
        "country": { "type": "string" },
        "isDefault": { "type": "boolean" },
        "type": { "type": "string", "enum": ["shipping", "billing"] }
      },
      "required": ["fullName", "street", "city", "country"]
    },
    "PaymentMethod": {
      "title": "Payment Method",
      "description": "Saved payment card details (masked).",
      "type": "object",
      "properties": {
        "cardType": { "type": "string" },
        "last4": { "type": "string" },
        "expiryDate": { "type": "string" },
        "holderName": { "type": "string" },
        "isDefault": { "type": "boolean" }
      },
      "required": ["last4", "cardType", "expiryDate"]
    },
    "ActivityLog": {
      "title": "Activity Log",
      "description": "Historical record of user actions.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["order", "security", "profile", "wishlist", "system"] },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "description", "createdAt"]
    },
    "Media": {
      "title": "Media Asset",
      "description": "Uploaded images and assets for use across the site.",
      "type": "object",
      "properties": {
        "url": { "type": "string" },
        "publicId": { "type": "string" },
        "fileName": { "type": "string" },
        "fileSize": { "type": "number" },
        "fileType": { "type": "string" },
        "uploadedAt": { "type": "string", "format": "date-time" },
        "uploadedBy": { "type": "string" }
      },
      "required": ["url", "publicId"]
    },
    "AppSetting": {
      "title": "Application Setting",
      "description": "Global application configuration.",
      "type": "object",
      "properties": {
        "whatWeAreTitle": { "type": "string" },
        "whatWeAreHighlight": { "type": "string" },
        "whatWeAreDescription": { "type": "string" },
        "offers": { "type": "array" },
        "banners": { 
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "imageUrl": { "type": "string" },
              "link": { "type": "string" },
              "title": { "type": "string" }
            }
          }
        },
        "limitBanners": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "contactTitle": { "type": "string" },
        "contactSubtitle": { "type": "string" },
        "supportEmail": { "type": "string" },
        "partnershipsEmail": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "responseTime": { "type": "string" }
      }
    },
    "Policy": {
      "title": "Policy Document",
      "description": "Legal or operational store policy document.",
      "type": "object",
      "properties": {
        "slug": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["slug", "title", "content"]
    },
    "FAQ": {
      "title": "FAQ Item",
      "description": "Frequently asked question and answer.",
      "type": "object",
      "properties": {
        "question": { "type": "string" },
        "answer": { "type": "string" }
      },
      "required": ["question", "answer"]
    },
    "TaxRate": {
      "title": "Tax Rate",
      "description": "Country-specific sales tax rate percentage.",
      "type": "object",
      "properties": {
        "country": { "type": "string" },
        "ratePercent": { "type": "number" }
      },
      "required": ["country", "ratePercent"]
    }
  },
  "firestore": {
    "policies/{policyId}": {
      "schema": "Policy",
      "description": "Store policies such as shipping, refunds, warranty, privacy, and terms."
    },
    "faqs/{faqId}": {
      "schema": "FAQ",
      "description": "Frequently asked questions list."
    },
    "taxRates/{taxId}": {
      "schema": "TaxRate",
      "description": "Regional tax rates by country."
    },
    "settings/{settingId}": {
      "schema": "AppSetting",
      "description": "Global site settings and configuration."
    },
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles and role assignments."
    },
    "users/{userId}/addresses/{addressId}": {
      "schema": "Address",
      "description": "User-specific shipping and billing addresses."
    },
    "users/{userId}/payments/{paymentId}": {
      "schema": "PaymentMethod",
      "description": "User-specific saved payment methods."
    },
    "users/{userId}/wishlist/{productId}": {
      "schema": "Product",
      "description": "User-specific wishlist items."
    },
    "users/{userId}/activity/{activityId}": {
      "schema": "ActivityLog",
      "description": "User-specific activity history logs."
    },
    "products/{productId}": {
      "schema": "Product",
      "description": "Store inventory of gadgets."
    },
    "categories/{categoryId}": {
      "schema": "Category",
      "description": "Product hierarchy."
    },
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders and payment statuses."
    },
    "coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Promotional codes."
    },
    "tickets/{ticketId}": {
      "schema": "Ticket",
      "description": "Customer support messages."
    },
    "media/{mediaId}": {
      "schema": "Media",
      "description": "Cloudinary asset library."
    },
    "products/{productId}/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Individual product reviews."
    }
  }
}
