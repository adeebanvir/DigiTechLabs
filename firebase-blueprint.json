{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Public and private user demographic and role information.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "admin", "support"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "Electronic gadget or accessory details.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "discount": { "type": "number" },
        "category": { "type": "string" },
        "image": { "type": "string" },
        "rating": { "type": "number" },
        "reviews": { "type": "number" },
        "isReviewsEnabled": { "type": "boolean" },
        "features": { "type": "array" },
        "specs": { "type": "object" },
        "stock": { "type": "number" },
        "isNew": { "type": "boolean" },
        "isBestSeller": { "type": "boolean" },
        "status": { "type": "string", "enum": ["published", "draft", "archived"] },
        "sku": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "category", "stock", "productId"]
    },
    "Category": {
      "title": "Category",
      "description": "Product categorization.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "image": { "type": "string" }
      },
      "required": ["name", "slug"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase transaction record with full tracking.",
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "paid", "processing", "shipped", "delivered", "cancelled", "refunded"] },
        "paymentStatus": { "type": "string", "enum": ["pending", "completed", "failed", "refunded"] },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "shippingAddress": { "type": "string" },
        "trackingCode": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "status", "items", "total"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Promotional discounts.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "discountType": { "type": "string", "enum": ["percentage", "fixed"] },
        "value": { "type": "number" },
        "expiryDate": { "type": "string", "format": "date-time" },
        "usageCount": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["code", "discountType", "value"]
    },
    "Ticket": {
      "title": "Support Ticket",
      "description": "Customer support inquiries.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "in-progress", "resolved", "closed"] },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "urgent"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Media": {
      "title": "Media Asset",
      "description": "Uploaded images and assets for use across the site.",
      "type": "object",
      "properties": {
        "url": { "type": "string" },
        "publicId": { "type": "string" },
        "fileName": { "type": "string" },
        "fileSize": { "type": "number" },
        "fileType": { "type": "string" },
        "uploadedAt": { "type": "string", "format": "date-time" },
        "uploadedBy": { "type": "string" }
      },
      "required": ["url", "publicId"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles and role assignments."
    },
    "products/{productId}": {
      "schema": "Product",
      "description": "Store inventory of gadgets."
    },
    "categories/{categoryId}": {
      "schema": "Category",
      "description": "Product hierarchy."
    },
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders and payment statuses."
    },
    "coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Promotional codes."
    },
    "tickets/{ticketId}": {
      "schema": "Ticket",
      "description": "Customer support messages."
    },
    "media/{mediaId}": {
      "schema": "Media",
      "description": "Cloudinary asset library."
    },
    "products/{productId}/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Individual product reviews."
    }
  }
}
