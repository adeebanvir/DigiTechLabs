rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny - Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HELPERS (Pillar 3 & 4) ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      // Bootstrapped Admin: adeebanvir09@gmail.com
      // Logic relies on verified email or explicit admin document
      return isVerified() && (
        request.auth.token.email == "adeebanvir09@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- VALIDATION BLUEPRINTS (Pillar 2, 5, 9, 10) ---

    function isValidUser(data) {
      return data.userId == request.auth.uid &&
             data.email is string && data.email.size() <= 100 &&
             data.role in ['customer', 'admin', 'support'] &&
             (data.role == 'customer' || isAdmin()); // Pillar 4: Only existing admins can escalate roles
    }

    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.get('price', 0) is number && data.get('price', 0) >= 0 &&
             data.get('stock', 0) is number && data.get('stock', 0) >= 0 &&
             data.get('category', 'Uncategorized') is string && data.get('category', '').size() <= 100 &&
             data.get('productId', 'TEMP') is string && data.get('productId', '').size() > 0 &&
             data.get('discount', 0) is number && data.get('discount', 0) >= 0 && data.get('discount', 0) <= 100 &&
             data.get('isReviewsEnabled', true) is bool &&
             data.get('isFeatured', false) is bool &&
             data.get('isNew', false) is bool &&
             data.get('isBestSeller', false) is bool &&
             data.get('status', 'published') in ['published', 'draft', 'archived'] &&
             data.get('image', '') is string && data.get('image', '').size() <= 2000;
    }

    function isValidOrder(data) {
      return data.userId is string &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 100 &&
             data.total is number && data.total >= 0 &&
             data.status in ['pending', 'paid', 'processing', 'shipped', 'delivered', 'cancelled', 'refunded'] &&
             data.customerName is string && data.email is string;
    }

    function isValidReview(data) {
      return data.userId == request.auth.uid &&
             data.productId is string && isValidId(data.productId) &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() <= 2000;
    }

    function isValidMedia(data) {
      return data.url is string && data.url.size() <= 1000 &&
             data.publicId is string && data.publicId.size() <= 255 &&
             data.fileName is string && data.fileName.size() <= 255 &&
             data.fileSize is number &&
             data.fileType is string && data.fileType.size() <= 100 &&
             data.uploadedBy == request.auth.uid;
    }

    // --- COLLECTION RULES ---

    // USERS (Pillar 6: PII isolation implicitly handled by isOwner/isAdmin)
    match /users/{userId} {
      allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId);
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming()) && isValidId(userId);
      allow update: if (isOwner(userId) || isAdmin()) && 
                    isValidUser(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt', 'status']) &&
                    incoming().updatedAt == request.time;
    }

    // ADMINS (Internal role lookup)
    match /admins/{adminId} {
      allow read: if isAdmin();
    }

    // PRODUCTS (Public Catalog)
    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true; // Pillar 8: Open catalog is intended; list queries don't check doc data here
      
      allow create: if isAdmin() && isValidProduct(incoming()) && isValidId(productId);
      allow update: if isAdmin() && isValidProduct(incoming()) && incoming().updatedAt == request.time;
      allow delete: if isAdmin();

      // REVIEWS (Pillar 1: Parent check)
      match /reviews/{reviewId} {
        allow read: if isValidId(reviewId);
        allow list: if true;
        allow create: if isVerified() && 
                      isValidReview(incoming()) && 
                      isValidId(reviewId) &&
                      exists(/databases/$(database)/documents/products/$(productId)); // Pillar 1: Relational Sync
        allow update, delete: if isAdmin() || isOwner(existing().userId);
      }
    }

    // CATEGORIES & COUPONS
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(categoryId);
    }

    match /coupons/{couponId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidId(couponId);
    }

    // TICKETS
    match /tickets/{ticketId} {
      allow get: if isOwner(existing().userId) || isAdmin();
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidId(ticketId);
      allow update: if isAdmin() || (isOwner(existing().userId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'message']));
    }

    // ORDERS (Pillar 8: Secure list queries)
    match /orders/{orderId} {
      allow get: if (isOwner(existing().userId) || isAdmin()) && isValidId(orderId);
      
      // Pillar 8: Rule enforces query boundary to prevent unauthorized scraping
      allow list: if isVerified() && (resource.data.userId == request.auth.uid || isAdmin());
      
      allow create: if isVerified() && 
                    isValidOrder(incoming()) && 
                    isValidId(orderId) &&
                    incoming().createdAt == request.time; // Pillar 10: Server time
      
      allow update: if isVerified() && (
        // Admin Action: Full State Management
        isAdmin() ||
        // User Action: Terminal State Control (Pillar 4 & 9)
        (
          isOwner(existing().userId) && 
          existing().status == 'pending' &&
          incoming().status == 'cancelled' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
          incoming().updatedAt == request.time
        )
      );
    }

    // MEDIA ASSETS
    match /media/{mediaId} {
      allow get: if isAdmin() && isValidId(mediaId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(mediaId) && 
                      isValidMedia(incoming()) && 
                      incoming().uploadedAt == request.time;
      allow delete: if isAdmin() && isValidId(mediaId);
    }
  }
}
